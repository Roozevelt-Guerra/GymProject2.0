# Configuração local do backend. Consulte o README para carregar estas variáveis.
# URL JDBC, sem usuário/senha embutidos. Preencha as credenciais do seu PostgreSQL.
DATABASE_URL=jdbc:postgresql://localhost:5432/maqpro
DATABASE_USERNAME=
DATABASE_PASSWORD=
# Importação única: true exige o arquivo até a primeira importação concluída.
# Para começar com um banco vazio sem JSON, defina false.
CATALOG_IMPORT_ENABLED=true
# Arquivo legado somente para leitura. Relativo à execução do backend ou absoluto.
CATALOG_FILE=data/equipment.json
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# País + DDD + número, somente dígitos. Exemplo de formato: 5585999999999
WHATSAPP_NUMBER=
# Ative quando estiver usando HTTPS em produção.
COOKIE_SECURE=false
